DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional: where the SQLite file lives (default: backend/db.sqlite3)
# SQLITE_PATH=/var/data/climate.sqlite3
# Identify yourself to Nominatim (their usage policy), e.g. "climate-analyzer/1.0 (you@example.com)"
GEOCODER_USER_AGENT=climate-hazard-analyzer/1.0
# Reverse proxies in front of the app (Render: 1). 0 locally.
NUM_PROXIES=0
